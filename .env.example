# TagsViewer — Template variabili d'ambiente
# Copia in .env e compila i valori

PORT=3000

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io  # AuraDB Free
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── LLM provider default per i nuovi progetti ──────────────────────
# Valori: 'bedrock' | 'claude' | 'azure-openai' | 'ollama'
LLM_PROVIDER=bedrock

# ── Ollama (modello locale — nessuna API key) ───────────────────────
# Installa Ollama da https://ollama.com, poi: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# Worker paralleli per XLSX tagging (1–5, default 1)
# XLSX_PARALLEL_WORKERS=3

# ── AWS Bedrock (Claude via SSO IAM) — opzione consigliata ─────────
# Profilo AWS CLI configurato con: aws configure sso
AWS_PROFILE=nome-profilo-sso
# Regione Bedrock (non disponibile in tutte le regioni — usare us-east-1 o eu-west-1)
BEDROCK_REGION=us-east-1
# Modello Claude su Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# ── Claude Anthropic (API Key diretta) — alternativa ───────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Azure OpenAI ───────────────────────────────────────────────────
# Metodo 1: API Key diretta
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Metodo 2: SSO via MSAL device-code (lascia AZURE_OPENAI_API_KEY vuota)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-app-id
# AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
